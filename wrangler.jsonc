{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "topcontractreview",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./website/public",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "topcontractreview.com",
      "custom_domain": true
    },
    {
      "pattern": "www.topcontractreview.com",
      "custom_domain": true
    }
  ]
}
